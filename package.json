{
  "name": "agent-readiness-cli",
  "version": "0.1.0",
  "description": "Scans a repo and generates/checks a CLAUDE.md or AGENTS.md context file for AI coding agents.",
  "bin": {
    "agent-readiness": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "@anthropic-ai/sdk": "^0.30.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.16.0",
    "@types/node": "^20.14.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
